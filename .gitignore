# ==============================
# WordPress
# ==============================
# Generated or local-only files
.htaccess
sitemap.xml
sitemap.xml.gz

# Prevent accidental new config adds (tracked ones remain tracked)
wp-config.php
wp-config-*.php

# Caches and temp
wp-content/advanced-cache.php
wp-content/wp-cache-config.php
wp-content/object-cache.php
wp-content/cache/
wp-content/backup-db/
wp-content/backups/
wp-content/upgrade/

# Uploads (large binaries; manage externally if needed)
wp-content/uploads/

# Legacy multisite dir
wp-content/blogs.dir/

# Debug logs
wp-content/debug.log

# ==============================
# Database dumps / misc
# ==============================
*.sql
*.sqlite
*.sqlite3
*.bak
*.tmp
*.temp
*.lock
